  56  drive_consumption(t) = 0;
  57  away_hours = SUM(t$(home(t) = 0), 1);
  58  drive_consumption(t)$(home(t) = 0 AND away_hours > 0) = daily_ev_need / away_hours;
  59   
  60  PARAMETERS cheapest_price(t) 'Saatlik en düşük kaynak fiyatı (TL/kWh)';
  61  cheapest_price(t) = min(price_grid(t), min(price_solar(t), price_wind(t)));
  62   
  63  VARIABLES
  64     Pgrid(t)         'Şebekeden alınan enerji (kW)'
  65     Ppv(t)           'Solar PV doğrudan kullanımı (kW)'
  66     Pwind(t)         'Rüzgar enerjisi kullanımı (kW)'
  67     P_batt_charge(t) 'Solar bataryaya şarj gücü (kW)'
  68     P_batt_discharge(t) 'Solar bataryadan deşarj gücü (kW)'
  69     P_ev(t)          'EV şarj gücü (kW)'
  70     SoE_ev(t)        'EV batarya durumu (kWh)'
  71     SoE_batt(t)      'Solar batarya doluluk durumu (kWh)'
  72     total_cost       'Toplam maliyet (TL)';
  73   
  74  POSITIVE VARIABLES Pgrid, Ppv, Pwind, P_batt_charge, P_batt_discharge, P_ev, SoE_ev, SoE_batt;
  75  BINARY VARIABLES b_batt_ch(t), b_batt_dis(t);
  76   
  77  EQUATIONS
  78     cost_def              'Toplam maliyet'
  79     power_balance(t)      'Enerji denge denklemi'
  80     solar_dispatch(t)     'Solar üretim dağılımı: direkt kullanım + depolama'
  81     wind_limit(t)         'Rüzgar üretim sınırı'
  82     ev_home_limit(t)      'EV sadece evdeyken şarj olur'
  83     ev_charge_need        'Günlük EV şarj ihtiyacı'
  84     ev_soe_init           'Başlangıç batarya durumu'
  85     ev_soe_balance(t)     'EV batarya enerjisi dengesi'
  86     ev_soe_final          'Günün sonunda gerekli EV batarya durumu'
  87     ev_soe_min_limit(t)   'EV batarya minimum limiti'
  88     ev_soe_max_limit(t)   'EV batarya maksimum limiti'
  89     batt_init             'Solar batarya başlangıç durumu'
  90     batt_discharge_init   'Solar batarya ilk saat deşarjı'
  91     batt_balance(t)       'Solar batarya enerji dengesi'
  92     batt_final            'Solar batarya günlük denge'
  93     batt_max(t)           'Solar batarya kapasite limiti'
  94     batt_charge_limit(t)  'Solar batarya şarj gücü limiti'
  95     batt_discharge_limit(t) 'Solar batarya deşarj gücü limiti'
  96     batt_ch_dis_excl(t)   'Solar batarya aynı anda şarj ve deşarj olamaz'
  97     batt_charge_bigM(t)   'Solar batarya şarj ikili değişken bağlantısı'
  98     batt_discharge_bigM(t) 'Solar batarya deşarj ikili değişken bağlantısı';
  99   
 100  cost_def..       total_cost =E= SUM(t, price_grid(t)*Pgrid(t)
 101                                         + price_solar(t)*Ppv(t)
 102                                         + price_wind(t)*Pwind(t));
 103   
 104  power_balance(t)..  Pgrid(t) + Ppv(t) + Pwind(t) + P_batt_discharge(t) =E= load_house(t) + P_ev(t) + P_batt_charge(t);
 105   
 106  solar_dispatch(t)..  Ppv(t) + P_batt_charge(t) =L= solar_cap(t);
 107   
 108  wind_limit(t)..     Pwind(t) =L= wind_cap(t);
 109   
 110  ev_home_limit(t)..  P_ev(t) =L= ev_charge_max * home(t);
 111   
 112  batt_charge_limit(t)..    P_batt_charge(t) =L= batt_charge_max;
 113   
 114  batt_discharge_limit(t).. P_batt_discharge(t) =L= batt_discharge_max;
 115   
 116  * Prevent simultaneous battery charge and discharge
 117  batt_ch_dis_excl(t)..    b_batt_ch(t) + b_batt_dis(t) =L= 1;
 118   
 119  batt_charge_bigM(t)..     P_batt_charge(t) =L= batt_charge_max * b_batt_ch(t);
 120   
 121  batt_discharge_bigM(t)..  P_batt_discharge(t) =L= batt_discharge_max * b_batt_dis(t);
 122   
 123  ev_charge_need..   SUM(t, P_ev(t) * CE_EV) =G= daily_ev_need;
 124   
 125  ev_soe_init..      SoE_ev('1') =E= SoE_ini + P_ev('1') * CE_EV - drive_consumption('1');
 126   
 127  ev_soe_balance(t)$(ord(t) > 1)..  SoE_ev(t) =E= SoE_ev(t-1) + P_ev(t) * CE_EV - drive_consumption(t);
 128   
 129  ev_soe_final..     SoE_ev('24') =G= SoE_ini;
 130   
 131  ev_soe_min_limit(t).. SoE_ev(t) =G= SoE_min;
 132  ev_soe_max_limit(t).. SoE_ev(t) =L= SoE_max;
 133   
 134  batt_init..         SoE_batt('1') =E= SoE_batt_ini + P_batt_charge('1') * CE_batt - P_batt_discharge('1') / CE_batt;
 135   
 136  batt_discharge_init.. P_batt_discharge('1') =E= 0;
 137   
 138  batt_balance(t)$(ord(t) > 1)..  SoE_batt(t) =E= SoE_batt(t-1) + P_batt_charge(t) * CE_batt - P_batt_discharge(t) / CE_batt;
 139   
 140  batt_final..        SoE_batt('24') =E= SoE_batt_ini;
 141   
 142  batt_max(t)..       SoE_batt(t) =L= battery_capacity;
 143   
 144  MODEL hybrid_ev /ALL/;
 145   
 146  SOLVE hybrid_ev MINIMIZING total_cost USING MIP;
 147   
 148  DISPLAY total_cost.l, Pgrid.l, Ppv.l, Pwind.l, P_batt_charge.l, P_batt_discharge.l, P_ev.l, SoE_ev.l, SoE_batt.l, drive_consumption, cheapest_price;
 149   
 150  * Notlar:
 151  * - Batarya modeli SoE_ev(t) ile EV batarya durumu için enerji akışını simüle eder.
 152  * - Solar batarya modeli SoE_batt(t), P_batt_charge(t) ve P_batt_discharge(t) değişkenleriyle kurulmuştur.
 153  * - Solar panel modeli solar_cap(t) ve Ppv(t) ile tanımlanmıştır.
 154  * - Solar batarya, gündüz güneş enerjisini depolayarak akşam kullanıma sunar.
 155  * - Rüzgar modeli wind_cap(t) ve Pwind(t) ile tanımlanmıştır.
 156  * - Hibrit şebeke modelinde şebeke maliyeti, solar ve rüzgar kullanımı birlikte minimize edilir.
 157  * - Kullanıcı davranışı home(t) ile EV'nin evde olduğu saatleri belirler.


